        "source_title": "Financial Transaction Quality Engineering Standards",
        "source_version": "1.0",
        "source_section": "Section 1.1 - Transaction Identity Integrity",
        "retrieved_at": "2026-10-15T00:00:00Z",
        "license": "MIT",
        "applicability": "Applies to transaction events requiring an immutable identity reference"
      },
      "placeholder_schema": {
        "$transaction_id": {
          "type": "COLUMN",
          "required": true
        }
      },
      "examples": [
        {
          "input": {"txn_id": "TXN_1001"},
          "bindings": {"$transaction_id": "txn_id"},
          "expected": {"transaction_id_not_null": "passed"}
        },
        {
          "input": {"txn_id": null},
          "bindings": {"$transaction_id": "txn_id"},
          "expected": {"transaction_id_not_null": "missing"}
        }
      ]
