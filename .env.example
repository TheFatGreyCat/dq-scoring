# DQ Scoring System — Environment Configuration Template (.env.example)

# SECURITY INSTRUCTION:
# 1. Copy this file to '.env' for local development: cp .env.example .env
# 2. Fill in your local credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
#    (.gitignore is configured to block '.env' and '.env.*' except '.env.example')
# 4. In production/k3s, supply these values via Kubernetes Secrets / HashiCorp Vault.


# Application Environment (development | staging | production)
DQ_APP_ENV=development
DQ_LOG_LEVEL=INFO
DQ_DEBUG=false


# PostgreSQL 16 Metadata & Durable Queue Store

DQ_POSTGRES_HOST=localhost
DQ_POSTGRES_PORT=5432
DQ_POSTGRES_DB=dq_scoring
DQ_POSTGRES_USER=dq_scoring
DQ_POSTGRES_PASSWORD=your_secure_postgres_password_here
DQ_POSTGRES_DSN=postgresql://your_user:your_secure_postgres_password_here@localhost:5432/dq_scoring
DQ_TEST_POSTGRES_DSN=postgresql://dq_scoring:dq_scoring_test@localhost:5432/dq_scoring_test
DQ_POSTGRES_POOL_SIZE=10
DQ_POSTGRES_MAX_OVERFLOW=5
DQ_POSTGRES_POOL_TIMEOUT=30


# S3 / MinIO Object Storage

DQ_S3_ENDPOINT_URL=http://localhost:9000
DQ_S3_ACCESS_KEY_ID=minioadmin
DQ_S3_SECRET_ACCESS_KEY=your_secure_minio_secret_key_here
DQ_S3_REGION=us-east-1
DQ_S3_USE_SSL=false
DQ_S3_BUCKET_STAGING=dq-staging-local
DQ_S3_BUCKET_SNAPSHOTS=dq-snapshots-local
DQ_S3_BUCKET_ARTIFACTS=dq-artifacts-local


# Apache Spark Engine

# For local development without Kubernetes: 'local[*]'
# For production on k3s: 'k8s://https://kubernetes.default.svc:443'
DQ_SPARK_MASTER=local[*]
# Driver + Executor + JVM overhead must remain within DQ_SPARK_MAX_MEMORY_MB (4096 MB):
# driver + driver overhead + instances x (executor + executor overhead) <= max; startup refuses otherwise.
DQ_SPARK_DRIVER_MEMORY=1024m
DQ_SPARK_DRIVER_MEMORY_OVERHEAD=256m
DQ_SPARK_EXECUTOR_MEMORY=1536m
DQ_SPARK_EXECUTOR_MEMORY_OVERHEAD=384m
DQ_SPARK_EXECUTOR_INSTANCES=1
DQ_SPARK_MAX_MEMORY_MB=4096
DQ_SPARK_MAX_CONCURRENT_RUNS=1
DQ_SPARK_SQL_SHUFFLE_PARTITIONS=4
# Kubernetes executor settings (used only when DQ_SPARK_MASTER starts with k8s://).
DQ_SPARK_KUBERNETES_NAMESPACE=dq-scoring
DQ_SPARK_KUBERNETES_EXECUTOR_IMAGE=dq-scoring-spark:dev
DQ_SPARK_KUBERNETES_SERVICE_ACCOUNT=dq-spark-driver
# Driver pod IP reachable by executors (required for k8s://; set from the downward API in the pod).
# DQ_SPARK_DRIVER_HOST=
DQ_SPARK_DRIVER_PORT=7078
DQ_SPARK_BLOCK_MANAGER_PORT=7079


# Security, JWT & Authentication (Argon2id + JWT
DQ_AUTH_ALGORITHM=HS256
DQ_AUTH_PRIVATE_KEY_PATH=.tmp/jwt_private.pem
DQ_AUTH_PUBLIC_KEY_PATH=.tmp/jwt_public.pem
# Khóa bí mật đối xứng (BẮT BUỘC tối thiểu 32 ký tự, áp dụng cho DQ_AUTH_ALGORITHM=HS256)
DQ_AUTH_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_min_32_chars
# Short-lived access token: 15-30 minutes per FR-AUTH-002
DQ_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
DQ_AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
# Login lockout per FR-AUTH-004: this many consecutive failures lock the account (HTTP 423)
DQ_LOGIN_MAX_FAILED_ATTEMPTS=5
DQ_LOGIN_LOCKOUT_MINUTES=15


# Presentation & Service Ports

DQ_API_HOST=0.0.0.0
DQ_API_PORT=8000
DQ_UI_HOST=0.0.0.0
DQ_UI_PORT=8501


# Evidence Redaction & Safety Boundaries (PROJECT_BRIEF §3.2)

DQ_MAX_SAMPLE_ROWS=50
DQ_MAX_EVIDENCE_BYTES=512000
DQ_EVIDENCE_REDACT_PII=true

# Import daemon and evaluation daemon require their own non-superuser worker DSN.
# DQ_WORKER_POSTGRES_DSN=
# Offline successor migration: sandbox admin only, never used automatically.
# DQ_MIGRATION_POSTGRES_DSN=
DQ_SPARK_EXECUTOR_CORES=1
DQ_IMPORT_MAX_BYTES=21474836480
DQ_IMPORT_PART_BYTES=16777216
DQ_IMPORT_MAX_COLUMNS=1000
DQ_IMPORT_MAX_RECORD_BYTES=8388608
DQ_IMPORT_TEMP_ROOT=.tmp/imports
DQ_IMPORT_LEASE_SECONDS=60
DQ_IMPORT_HEARTBEAT_SECONDS=5
